# Where the web app finds the Renewly API. Baked into the build, so set it BEFORE building.
#   http://localhost:8000      local API, called directly (cross-origin)
#   https://api.example.com    API on its own domain (same site as the web app)
#   /api                       same-origin proxy: the host forwards /api/* to the API
#                              (Vercel rewrite in vercel.json, or Vite's dev proxy). Use this
#                              when the web app and API are on unrelated domains such as
#                              *.vercel.app and *.up.railway.app, so the login cookie is first-party.
VITE_API_URL=http://localhost:8000
