# Copy to .env and adjust. Every value here is read by app/core/config.py.

# --- Required ---------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/expiry_tracker
# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app refuses to start if this is under 32 characters or starts with "change-me".
SECRET_KEY=change-me-to-a-long-random-string

# --- Optional (defaults shown) ---------------------------------------------
# Redis: Celery broker and rate-limit counters.
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Timezone given to users who do not choose one at sign-up (IANA name).
DEFAULT_TIMEZONE=Africa/Lagos
# "development" or "production". Production makes a missing RESEND_API_KEY a hard error.
APP_ENV=development

# Browser origins allowed to call the API, comma separated. In production set this to
# the frontend's public URL, e.g. https://renewly-web.up.railway.app
CORS_ORIGINS=http://localhost:5173

# Public URL of the web app. Password-reset emails link here (/reset-password?token=...).
FRONTEND_URL=http://localhost:5173

# --- Email (Resend) ---------------------------------------------------------
# Leave empty in development: emails are written to the log instead of sent.
RESEND_API_KEY=
# Must use a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=Expiry Tracker <onboarding@resend.dev>

# --- Operations -------------------------------------------------------------
# "text" is readable in a terminal, "json" is one object per line for log tools.
LOG_FORMAT=text
LOG_LEVEL=INFO
# "redis" (shared by all processes) or "memory" (single process only).
RATE_LIMIT_BACKEND=redis

# --- Error tracking (optional) ----------------------------------------------
# Sentry project DSN. Empty disables it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
